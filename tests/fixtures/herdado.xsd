<?xml version="1.0" encoding="UTF-8"?>
<!-- Aliases de tipo: <xs:restriction base="X"/> sem facets proprios. O facet
     mora no tipo base, e quem so olhar o dicionario de facets do tipo derivado
     vai gerar um valor do tamanho errado. O eSocial usa esse padrao aos montes
     (TS_nrProcJud_1 sobre TS_nrProcJud). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="TProcesso">
    <xs:restriction base="xs:string">
      <xs:length value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TProcessoJudicial">
    <xs:restriction base="TProcesso"/>
  </xs:simpleType>

  <xs:simpleType name="TValorBase">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="15"/>
      <xs:fractionDigits value="4"/>
      <xs:minInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TValorAlias">
    <xs:restriction base="TValorBase"/>
  </xs:simpleType>

  <xs:simpleType name="TCodigoBase">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,8}"/>
      <xs:minLength value="8"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCodigoAlias">
    <xs:restriction base="TCodigoBase"/>
  </xs:simpleType>

  <xs:element name="processo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="numero" type="TProcessoJudicial"/>
        <xs:element name="valor" type="TValorAlias"/>
        <xs:element name="codigo" type="TCodigoAlias"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
